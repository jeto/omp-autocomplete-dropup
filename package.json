{
  "name": "omp-autocomplete-dropup",
  "version": "0.2.1",
  "description": "oh-my-pi extension: show the prompt autocomplete dropdown above the input, overlaid on the transcript, so the input never moves",
  "license": "MIT",
  "author": "Jere Toivonen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeto/omp-autocomplete-dropup.git"
  },
  "type": "module",
  "files": [
    "src",
    "README.md"
  ],
  "keywords": [
    "omp",
    "oh-my-pi",
    "omp-plugin",
    "autocomplete"
  ],
  "scripts": {
    "typecheck": "tsc -p .",
    "smoke": "uv run test/smoke.py"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "19.2.0",
    "@oh-my-pi/pi-tui": "19.2.0",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ],
    "settings": {
      "mode": {
        "type": "enum",
        "values": [
          "overlay",
          "inline"
        ],
        "default": "overlay",
        "description": "overlay: draw the list over the transcript above the input; inline: insert it above the input and push the transcript up"
      }
    }
  }
}
